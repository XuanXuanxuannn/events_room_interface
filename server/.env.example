PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Absolute or relative path for SQLite + file storage
DATA_DIR=./storage

# Comma-separated origins, or * for open LAN demos
CORS_ORIGINS=*

# Admin bootstrap (used by seed-admin / first boot if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cbrin123

# Session / token lifetime in hours
SESSION_TTL_HOURS=12

# Upload limits
MAX_UPLOAD_MB=30

# Presence / room TTL in milliseconds
PRESENCE_TTL_MS=30000
ROOM_EXPIRE_HOURS=12

# Cleanup interval in milliseconds (default 15 minutes)
CLEANUP_INTERVAL_MS=900000

# LibreOffice binary for PPT/PPTX conversion (optional)
# macOS: /Applications/LibreOffice.app/Contents/MacOS/soffice
# Linux: soffice or libreoffice
LIBREOFFICE_BIN=soffice

# Cookie signing secret — change in production
SESSION_SECRET=change-me-to-a-long-random-string

# LAN screen sharing requires HTTPS (browsers block getDisplayMedia on http://LAN-IP).
# Generate certs: npm run generate-certs
ENABLE_HTTPS=true
# HTTPS_PORT=3000
# CERT_DIR=./storage/certs
# TLS_KEY_PATH=./storage/certs/key.pem
# TLS_CERT_PATH=./storage/certs/cert.pem
